# ── Logging ─────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR. DEBUG logs all MQTT messages.
# SKITTER_LOG_LEVEL=INFO

# ── A2A-over-MQTT ──────────────────────────────────────
# Organisation and unit segments for A2A topic hierarchy
SKITTER_A2A_ORG=skitter
SKITTER_A2A_UNIT=default

# ── MQTT broker ──────────────────────────────────────────
# Schemes: mqtt:// (plain) or mqtts:// (TLS). Default ports: 1883 / 8883.
MQTT_BROKER_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_CA_CERT=          # path to custom CA certificate for mqtts://

# ── LLM provider (coordinator needs one for graph generation) ──
# API key for the configured provider.
SKITTER_LLM_API_KEY=

# Which API to use: anthropic (default), openai, openai-completions, or deepseek.
# SKITTER_LLM_API=anthropic

# Model name (no provider prefix needed).
SKITTER_LLM_MODEL=claude-sonnet-4-6
# SKITTER_LLM_MODEL=gpt-5.4-mini
# SKITTER_LLM_MODEL=deepseek-chat

# Optional: custom base URL for either API (e.g. proxy or self-hosted).
# SKITTER_LLM_BASE_URL=
