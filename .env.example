# ── MQTT broker ──────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883

# ── LLM provider (coordinator needs one for graph generation) ──
# Set the key for your provider — litellm picks it up automatically.
# See https://docs.litellm.ai/docs/providers for all supported providers.
ANTHROPIC_API_KEY=          # for Claude models
# OPENAI_API_KEY=           # for OpenAI models
# GEMINI_API_KEY=           # for Gemini models

# Model string (provider/model, litellm format).
# Also settable in ~/.skitter/config.yaml → llm.model
SKITTER_LLM_MODEL=anthropic/claude-sonnet-4-6

# ── A2A-over-MQTT ──────────────────────────────────────
# Organisation and unit segments for A2A topic hierarchy
SKITTER_A2A_ORG=skitter
SKITTER_A2A_UNIT=default
