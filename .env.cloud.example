# Cloud mode — EMQX Serverless + Fly Machines
SKITTER_SPAWN_MODE=fly

# MQTT broker (EMQX Serverless)
MQTT_HOST=xyz.ala.eu-central-1.emqxsl.com
MQTT_PORT=8883
MQTT_TLS=1
MQTT_USER=skitter
MQTT_PASS=<secret>

# EMQX REST API (for deploy + discovery cards)
EMQX_API_URL=https://xyz.ala.eu-central-1.emqxsl.com:8443/api/v5
EMQX_API_KEY=<api-key>
EMQX_API_SECRET=<api-secret>

# Fly Machines
FLY_API_TOKEN=<fly-api-token>
FLY_APP=skitter
FLY_REGION=iad

# API keys for workers
ANTHROPIC_API_KEY=<key>
OPENAI_API_KEY=<key>
