# ── MQTT broker ──────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883

# ── API keys ─────────────────────────────────────────────
# Anthropic API key (required)
# Get one → https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram bot token (optional)
# Get one → talk to @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ── Model configuration ─────────────────────────────────
# Which model the planner/synthesizer/QA agents use
SKITTER_PLANNER_MODEL=sonnet

# Available worker models  (name:description|name:description|…)
SKITTER_MODELS=haiku:Fast and cheap, good for simple tasks and summaries|sonnet:Balanced, good for research and analysis|opus:Most capable, use for complex reasoning and coding
