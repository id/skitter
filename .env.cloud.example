# Cloud mode — EMQX Serverless + Fly Machines

# MQTT broker (EMQX Serverless)
MQTT_HOST=xyz.ala.eu-central-1.emqxsl.com
MQTT_PORT=8883
MQTT_TLS=1
MQTT_USER=skitter
MQTT_PASS=<secret>

# Fly Machines
FLY_API_TOKEN=<fly-api-token>
FLY_APP=skitter
FLY_REGION=iad

# Worker auth — either API key or OAuth token (not both needed)
ANTHROPIC_API_KEY=<key>
CLAUDE_CODE_OAUTH_TOKEN=<token from `claude setup-token`>
OPENAI_API_KEY=<key>
