# ── MQTT broker ──────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883

# ── API keys ─────────────────────────────────────────────
# Anthropic API key (required)
# Get one → https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram bot token (optional)
# Get one → talk to @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ── A2A-over-MQTT ──────────────────────────────────────
# Organisation and unit segments for A2A topic hierarchy
SKITTER_A2A_ORG=skitter
SKITTER_A2A_UNIT=default

# ── Model configuration ─────────────────────────────────
# Available worker models  (name:description|name:description|…)
SKITTER_MODELS=haiku:Fast and cheap, good for simple tasks and summaries|sonnet:Balanced, good for research and analysis|opus:Most capable, use for complex reasoning and coding

# ── Worker sandboxing ───────────────────────────────────
# Worker execution mode: "subprocess" (default) or "docker"
SKITTER_WORKER_MODE=subprocess

# Docker image for workers (when SKITTER_WORKER_MODE=docker)
SKITTER_WORKER_IMAGE=skitter-worker:latest

# Docker network workers join (must match docker-compose.yml)
SKITTER_DOCKER_NETWORK=skitter

# MQTT host workers use inside Docker (container name of EMQX)
SKITTER_DOCKER_MQTT_HOST=emqx
