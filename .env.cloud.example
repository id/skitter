# Cloud mode — EMQX Cloud + R2 storage
SKITTER_SPAWN_MODE=subprocess
SKITTER_STORAGE=r2
MQTT_HOST=xyz.emqx.cloud
MQTT_PORT=8883
MQTT_TLS=1
MQTT_USER=skitter
MQTT_PASS=<secret>

# EMQX REST API (for serverless supervisor and deploy)
EMQX_API_URL=https://xyz.emqx.cloud:8443/api/v5
EMQX_API_KEY=<api-key>
EMQX_API_SECRET=<api-secret>

# API keys for workers
ANTHROPIC_API_KEY=<key>
OPENAI_API_KEY=<key>
